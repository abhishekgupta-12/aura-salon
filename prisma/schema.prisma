datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"

}

// ─── AUTH & USERS ───
model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  phone          String?
  role           Role      @default(OWNER)
  salonId        String?   @db.ObjectId
  salon          Salon?    @relation(fields: [salonId], references: [id])
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  MANAGER
  STAFF
  RECEPTIONIST
}

// ─── SALON ───
model Salon {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String        @unique
  logo           String?
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  gstNumber      String?
  taxRate        Float         @default(18)
  currency       String        @default("INR")
  businessHours  Json?
  whatsappConfig Json?
  users          User[]
  staff          Staff[]
  customers      Customer[]
  services       Service[]
  categories     Category[]
  appointments   Appointment[]
  invoices       Invoice[]
  products       Product[]
  suppliers      Supplier[]
  campaigns      Campaign[]
  reviews        Review[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ─── STAFF ───
model Staff {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String?
  phone        String
  image        String?
  role         String
  salary       Float         @default(0)
  commission   Float         @default(0)
  serviceIds   String[]      @db.ObjectId
  salonId      String        @db.ObjectId
  salon        Salon         @relation(fields: [salonId], references: [id])
  appointments Appointment[]
  attendance   Attendance[]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Attendance {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  staffId   String    @db.ObjectId
  staff     Staff     @relation(fields: [staffId], references: [id])
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  status    String    @default("present")
  createdAt DateTime  @default(now())
}

// ─── CUSTOMERS ───
model Customer {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String?
  phone        String
  image        String?
  birthday     DateTime?
  notes        String?
  loyaltyPts   Int           @default(0)
  tier         String        @default("REGULAR")
  tags         String[]
  salonId      String        @db.ObjectId
  salon        Salon         @relation(fields: [salonId], references: [id])
  appointments Appointment[]
  invoices     Invoice[]
  reviews      Review[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─── SERVICES ───
model Category {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  salonId  String    @db.ObjectId
  salon    Salon     @relation(fields: [salonId], references: [id])
  services Service[]
}

model Service {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  price      Float
  duration   Int
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])
  salonId    String   @db.ObjectId
  salon      Salon    @relation(fields: [salonId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ─── APPOINTMENTS ───
model Appointment {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  customerId String            @db.ObjectId
  customer   Customer          @relation(fields: [customerId], references: [id])
  staffId    String            @db.ObjectId
  staff      Staff             @relation(fields: [staffId], references: [id])
  salonId    String            @db.ObjectId
  salon      Salon             @relation(fields: [salonId], references: [id])
  serviceIds String[]          @db.ObjectId
  startTime  DateTime
  endTime    DateTime
  status     AppointmentStatus @default(SCHEDULED)
  type       String            @default("booking")
  notes      String?
  invoiceId  String?           @db.ObjectId
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─── BILLING ───
model Invoice {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String        @unique
  customerId    String        @db.ObjectId
  customer      Customer      @relation(fields: [customerId], references: [id])
  salonId       String        @db.ObjectId
  salon         Salon         @relation(fields: [salonId], references: [id])
  items         InvoiceItem[]
  subtotal      Float
  taxAmount     Float
  discount      Float         @default(0)
  total         Float
  paymentMethod String?
  paymentStatus String        @default("pending")
  pdfUrl        String?
  notes         String?
  createdAt     DateTime      @default(now())
}

model InvoiceItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String  @db.ObjectId
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  name      String
  type      String
  quantity  Int
  unitPrice Float
  total     Float
}

// ─── INVENTORY ───
model Product {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  sku       String?
  price     Float
  costPrice Float     @default(0)
  stock     Int       @default(0)
  minStock  Int       @default(5)
  unit      String    @default("pcs")
  supplierId String?  @db.ObjectId
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  salonId   String    @db.ObjectId
  salon     Salon     @relation(fields: [salonId], references: [id])
  image     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Supplier {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String?
  phone     String?
  address   String?
  salonId   String    @db.ObjectId
  salon     Salon     @relation(fields: [salonId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
}

// ─── MARKETING ───
model Campaign {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      String
  template  String
  status    String   @default("draft")
  sentCount Int      @default(0)
  salonId   String   @db.ObjectId
  salon     Salon    @relation(fields: [salonId], references: [id])
  schedule  Json?
  createdAt DateTime @default(now())
}

// ─── REVIEWS ───
model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id])
  salonId    String   @db.ObjectId
  salon      Salon    @relation(fields: [salonId], references: [id])
  rating     Int
  comment    String?
  response   String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
}
